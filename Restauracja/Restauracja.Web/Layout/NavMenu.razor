
<nav class="navbar navbar-expand-md pasek">
    <div class="container-fluid pasek-srodek">
        <a class="navbar-brand" href="">Przy Stole</a>

        <button class="navbar-toggler" type="button"
                title="Pokaż lub ukryj menu"
                @onclick="PrzelaczMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse @KlasaMenu"
             @onclick="ZwinMenu">
            <div class="navbar-nav ms-auto linki">
                <NavLink class="nav-link" href="menu">Menu</NavLink>
                <NavLink class="nav-link koszyk" href="cart">Koszyk</NavLink>
            </div>
        </div>
    </div>
</nav>

@code {
    private bool menuOtwarte = false;

    private string KlasaMenu => menuOtwarte ? "show" : "";

    private void PrzelaczMenu()
    {
        menuOtwarte = !menuOtwarte;
    }

    private void ZwinMenu()
    {
        menuOtwarte = false;
    }
}

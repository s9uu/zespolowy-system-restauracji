@Restauracja.Api_HostAddress = https://localhost:7097

GET {{Restauracja.Api_HostAddress}}/api/menu
Accept: application/json

###

# Złożenie zamówienia. SposobOdbioru: 0 = na miejscu, 1 = na wynos.
# Żurek dwa razy osobno: Api połączy go w jedną pozycję (3 szt.).
POST {{Restauracja.Api_HostAddress}}/api/zamowienia
Content-Type: application/json

{
  "imieKlienta": "Anna",
  "sposobOdbioru": 0,
  "pozycje": [
    { "danieId": 1, "ilosc": 2 },
    { "danieId": 8, "ilosc": 1 },
    { "danieId": 1, "ilosc": 1 }
  ]
}

###

# Sernik (id 3) jest niedostępny: 400 z nazwą dania.
POST {{Restauracja.Api_HostAddress}}/api/zamowienia
Content-Type: application/json

{
  "imieKlienta": "Tomek",
  "sposobOdbioru": 1,
  "pozycje": [ { "danieId": 3, "ilosc": 1 } ]
}

###

# Wpisz kod zwrócony przez POST. Małe litery też działają.
GET {{Restauracja.Api_HostAddress}}/api/zamowienia/ABC234
Accept: application/json

###

GET {{Restauracja.Api_HostAddress}}/api/kuchnia/zamowienia
Accept: application/json

###

# Wpisz kod z POST. Status tylko o jeden krok: WPrzygotowaniu, Gotowe, Wydane.
PUT {{Restauracja.Api_HostAddress}}/api/kuchnia/zamowienia/ABC234/status/WPrzygotowaniu

###

# Bez tego Wydane da 409.
PUT {{Restauracja.Api_HostAddress}}/api/kuchnia/zamowienia/ABC234/oplacone

###
